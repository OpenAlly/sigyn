{
  "name": "@sigyn/pattern",
  "version": "2.0.0",
  "description": "Loki pattern in JavaScript",
  "exports": "./dist/pattern.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test-types": "tstyche",
    "test-only": "node --test ./test/**/*.spec.ts",
    "test": "npm run test-only && npm run test-types",
    "coverage": "c8 -r html npm test",
    "lint": "eslint src test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAlly/sigyn.git",
    "directory": "src/pattern"
  },
  "bugs": {
    "url": "https://github.com/OpenAlly/sigyn/issues"
  },
  "homepage": "https://github.com/OpenAlly/sigyn/blob/main/src/pattern/README.md",
  "files": [
    "dist"
  ],
  "keywords": [
    "grafana",
    "loki",
    "pattern",
    "log",
    "logs"
  ],
  "tsd": {
    "directory": "/test/types"
  },
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "tstyche": "7.2.2"
  }
}
