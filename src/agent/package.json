{
  "name": "@sigyn/agent",
  "version": "4.1.1",
  "description": "Loki alerting agent",
  "type": "module",
  "exports": "./dist/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npm run build -- --watch",
    "prepublishOnly": "npm run build",
    "test": "node --env-file-if-exists=.env --test-concurrency=1 --test ./test/**/*.spec.ts",
    "test:e2e": "node --env-file-if-exists=.env --test ./test/e2e/*.e2e-spec.ts",
    "coverage": "c8 -r html npm test",
    "lint": "eslint src test"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAlly/sigyn.git",
    "directory": "src/agent"
  },
  "bugs": {
    "url": "https://github.com/OpenAlly/sigyn/issues"
  },
  "homepage": "https://github.com/OpenAlly/sigyn/blob/main/src/agent/README.md",
  "files": [
    "dist",
    "data"
  ],
  "keywords": [],
  "author": "GENTILHOMME Thomas <gentilhomme.thomas@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@openally/httpie": "^1.1.2",
    "@openally/loki": "7.0.2",
    "@openally/result": "3.1.0",
    "better-sqlite3": "13.0.2",
    "cron-parser": "^5.3.0",
    "dayjs": "^1.11.13",
    "ms": "^2.1.3",
    "pino": "^10.0.0",
    "toad-scheduler": "4.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "is-ci": "^4.1.0",
    "mockdate": "^3.0.5"
  },
  "optionalDependencies": {
    "pino-pretty": "13.1.3"
  }
}
